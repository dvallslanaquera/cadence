# ---- Database (Railway Postgres) ----
# Pooled connection string for the app.
DATABASE_URL="postgresql://user:pass@host:port/railway?sslmode=require"

# ---- Auth.js ----
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Login allowlist AND runaway-timer alert recipient.
ALLOWED_EMAIL="you@example.com"

# ---- Runaway timer alert ----
RESEND_API_KEY=""
# Must be a verified Resend sender. onboarding@resend.dev works when the
# recipient is your own Resend account address.
ALERT_FROM_EMAIL="Cadence <onboarding@resend.dev>"
# openssl rand -hex 32 — shared with the GitHub Actions workflow.
CRON_SECRET=""
